APP_NAME="Dvorik Admin"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
CACHE_PREFIX=dvorik_laravel
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_DOMAIN=null
SESSION_PATH=/

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=dvorik_admin
DB_USERNAME=postgres
DB_PASSWORD=secret
DB_SCHEMA=public

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_SUPERADMIN_CHAT_ID=

FILESYSTEM_DISK_PUBLIC_URL=${APP_URL}/storage
FILESYSTEM_CLOUD=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=

QUEUE_REDIS_QUEUE=default
QUEUE_FAILED_DRIVER=database-uuids
QUEUE_FAILED_TABLE=failed_jobs
QUEUE_FAILED_PRUNING=168

SANCTUM_STATEFUL_DOMAINS=localhost
LIVEWIRE_URL=
LIVEWIRE_APP_URL=${APP_URL}
FILAMENT_PATH=/admin
FILAMENT_DEFAULT_GUARD=filament

SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_NAME=Super Admin
SUPERADMIN_PASSWORD=changeme

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
